# =================================================
# OVERSCITE AI - ENVIRONMENT VARIABLES TEMPLATE
# =================================================
# Copy this file to .env.local for local development
# and populate with your actual credentials.
# DO NOT COMMIT .env.local or any file with secrets.
# =================================================

# === PUBLIC FIREBASE WEB CONFIG (NOT SECRET) ===
# Get this from your Firebase project settings
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_APP_ID"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID" # Optional, for Analytics

# === RUNTIME ENV ===
# Set to "dev", "staging", or "prod"
NEXT_PUBLIC_APP_ENV="dev"
NEXT_PUBLIC_APP_NAME="OVERSCITE AI"

# === EXTERNAL SERVICES (PUBLIC KEYS) ===
# For map features
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyA-wbyNedwOjpbGrhxSYuY7KF3p72oUBcE"
# For "Hey, Scing!" wake word
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY="YOUR_PICOVOICE_ACCESS_KEY"
# For real-time messaging
NEXT_PUBLIC_STREAM_API_KEY="YOUR_STREAM_API_KEY"


# =================================================
# SERVER-SIDE SECRETS (DO NOT EXPOSE TO CLIENT)
# =================================================
# These are used in Next.js Server Components, API Routes, or Firebase Functions.
# For local dev, they are in .env.local. For production, they MUST be in your hosting environment's secrets management (e.g., Vercel Environment Variables, GitHub Secrets).

# === AI/MODEL PROVIDERS (SECRET) ===
# Used for LARI engine flows
OPENAI_API_KEY="sk-YOUR_OPENAI_API_KEY"
# For Google AI Studio / Vertex AI
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
VERTEX_PROJECT_ID="YOUR_GCP_PROJECT_ID"
VERTEX_LOCATION="us-central1" # Or your GCP region
# This is the JSON content of your GCP service account key, as a single-line string.
# OR you can set GOOGLE_APPLICATION_CREDENTIALS to a file path locally.
GOOGLE_APPLICATION_CREDENTIALS_JSON=""

# === AUTH / SECURITY (SECRET) ===
# Generate with `openssl rand -base64 64`
JWT_ACCESS_TOKEN_SECRET="YOUR_64_BYTE_RANDOM_SECRET"
JWT_REFRESH_TOKEN_SECRET="YOUR_64_BYTE_RANDOM_SECRET"
SCING_ENGINE_MASTER_KEY="YOUR_64_BYTE_RANDOM_SECRET"
BANE_POLICY_HASH_KEY="YOUR_64_BYTE_RANDOM_SECRET"
SRT_SIGNAL_SALT="YOUR_32_BYTE_RANDOM_SECRET"

# === OBSERVABILITY (SECRET/SEMI) ===
SENTRY_DSN="YOUR_SENTRY_DSN"
LOG_LEVEL="debug" # "debug", "info", "warn", "error"

# === FILE STORAGE (SECRET) ===
# For direct S3 uploads
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_S3_REGION="YOUR_AWS_S3_REGION"
AWS_S3_BUCKET="YOUR_AWS_S3_BUCKET_NAME"

# === EMAIL (SECRET) ===
# Option 1: SendGrid
SENDGRID_API_KEY="YOUR_SENDGRID_API_KEY"
# Option 2: SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-user"
SMTP_PASS="your-password"
EMAIL_FROM="Scingular AI <no-reply@yourdomain.com>"

# === SMS / VOICE (OPTIONAL, SECRET) ===
TWILIO_ACCOUNT_SID="YOUR_TWILIO_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_FROM_NUMBER="+15551234567"

# === AVATAR VOICE (OPTIONAL, SECRET) ===
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"
AZURE_SPEECH_KEY="YOUR_AZURE_SPEECH_KEY"
AZURE_SPEECH_REGION="YOUR_AZURE_SPEECH_REGION"

# === RIVE (OPTIONAL, SECRET) ===
RIVE_LICENSE_KEY="YOUR_RIVE_LICENSE_KEY"
